NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jalmitra:jalmitra@localhost:5432/jalmitra?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Shared secret that field hardware / simulator sends in the x-device-key header
DEVICE_API_KEY=jalmitra-device-key
# Optional: leave blank to disable
REDIS_URL=
MQTT_URL=
# Pumping cost used for the water-savings audit (Rs per 1,000 litres)
WATER_COST_PER_KL=5
# Safety failsafe: valve is force-closed after this many minutes
MAX_VALVE_RUN_MINUTES=120
